# ============================================================
# ควรอัปขึ้น Git (อย่าใส่ในไฟล์นี้)
# ------------------------------------------------------------
# - ซอร์สโค้ด: src/, public/, supabase/ (schema/migrations)
# - รูปที่ใช้จริงบนเว็บ: public/image/, public/*.png|svg
# - คอนฟิกโปรเจกต์: package.json, package-lock.json,
#   next.config.ts, tsconfig.json, eslint.config.mjs,
#   postcss.config.mjs, README.md, .gitignore
# - หน้า Coming Soon / components ที่แก้แล้ว
#
# ไม่ต้องอัป (รายการด้านล่าง = ignore)
# ------------------------------------------------------------
# - node_modules, .next, ไฟล์ build
# - .env* (secrets / API keys)
# - .vercel, โฟลเดอร์ทดลอง/_reference/_recovered
# - log, OS junk, typescript cache
# ============================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# local references / recovered dumps (not part of the app)
/_reference/
/_recovered/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — อย่าอัปขึ้น Git (ใส่ secrets)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.idea/
.vscode/
*.swp
*.swo
